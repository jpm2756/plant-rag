# --- LLM ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o-mini

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_HOST_PORT=5433
POSTGRES_USER=plantrag
POSTGRES_PASSWORD=plantrag
POSTGRES_DB=plantrag

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=plants

# --- Retrieval (defaults are the winners from eval/, see README) ---
DENSE_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RETRIEVAL_MODE=hybrid_rerank
TOP_K=5
CANDIDATE_K=30
RRF_K=60
PROMPT_VARIANT=v2

# --- Ingestion ---
USDA_API_BASE=https://plantsservices.sc.egov.usda.gov/api
USDA_MAX_WORKERS=4
INGEST_LIMIT=0          # 0 = all ~2,186 characterized species
INCLUDE_FACTSHEETS=1    # fetch + index USDA fact-sheet / plant-guide PDFs

# --- Ports (host side) ---
API_PORT=8000
UI_PORT=8501
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
